#!/usr/bin/env ruby
require "open3"
require "yaml"

root = File.expand_path("..", __dir__)
git_directory, git_status = Open3.capture2("git", "-C", root, "rev-parse", "--path-format=absolute", "--git-common-dir")
abort "Could not locate the project Git directory" unless git_status.success?
configuration_directory = File.join(git_directory.strip, "gh")
credentials_path = File.join(configuration_directory, "hosts.yml")
abort "Configure project credentials first: docs/development.md#github-cli" unless File.file?(credentials_path)
abort "File #{credentials_path} must have permissions 600" unless (File.stat(credentials_path).mode & 0o777) == 0o600

account = "serge-masiutin"
credentials = YAML.safe_load(File.read(credentials_path)).fetch("github.com")
abort "Project account must be #{account}" unless credentials.fetch("user") == account
token = credentials.fetch("users").fetch(account).fetch("oauth_token")
abort "Project token is missing" unless token.is_a?(String) && !token.empty?

# auth login/logout/switch affect the shared macOS Keychain even with GH_CONFIG_DIR.
if ARGV.first == "auth" && ARGV[1] != "status"
  abort "Only auth status is allowed here. Manage credentials via docs/development.md#github-cli"
end

executable = ENV.fetch("PATH").split(File::PATH_SEPARATOR).map { |directory| File.join(directory, "gh") }.find do |path|
  File.file?(path) && File.executable?(path) && !File.identical?(path, __FILE__)
end
abort "Install GitHub CLI: https://cli.github.com" unless executable

environment = {
  "GH_CONFIG_DIR" => configuration_directory,
  "GH_TOKEN" => token,
  "GITHUB_TOKEN" => nil,
  "GH_ENTERPRISE_TOKEN" => nil,
  "GITHUB_ENTERPRISE_TOKEN" => nil,
  "GH_HOST" => "github.com",
  "GH_REPO" => "serge-masiutin/opencode-session-checkpoint",
  "GH_DEBUG" => nil,
  "DEBUG" => nil
}

# Verify identity before the command can affect another account's repository.
login, error, status = Open3.capture3(environment, executable, "api", "user", "--jq", ".login", chdir: root)
abort "Could not verify project credentials: #{error.strip}" unless status.success?
abort "GitHub returned account #{login.strip}; expected #{account}" unless login.strip == account

exec(environment, executable, *ARGV, chdir: root)
